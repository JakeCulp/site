---
/**
 * Site navigation: logo + links.
 * Define links in one place; add/remove items in the `links` array.
 */
const links = [
  { href: "/", label: "Work" },
  { href: "/about", label: "About" },
  { href: "/links", label: "Links" },
];

import ArrowBendUpLeft from "phosphor-astro/ArrowBendUpLeft.astro";

// Determine current path
const { url } = Astro;
const currentPath = url.pathname.endsWith("/") && url.pathname.length > 1
  ? url.pathname.slice(0, -1)
  : url.pathname;

// Utility function to check if link is active
function isActive(href: string) {
  // Always normalize: treat "/about" and "/about/" as the same
  const normalizedHref = href.endsWith("/") && href.length > 1 ? href.slice(0, -1) : href;
  return normalizedHref === currentPath;
}
---

<header class="pt-12 max-w-4xl m-auto">
  <nav
    class="mx-auto flex items-center justify-between px-6 lg:px-0"
    aria-label="Main navigation"
  >
    <div class="p-3 bg-taupe-100 rounded-full transition hover:bg-taupe-200 ">
      <a href="/">
        <ArrowBendUpLeft class="overflow-hidden w-8 h-8 fill-taupe-600 hover:fill-taupe-900" />
      </a>
    </div>
    <ul class="flex list-none gap-2 p-0 m-0 text-xl">
      {
        links.map(({ href, label }) => {
          const active = isActive(href);
          return (
            <li>
              <a
                href={href}
                class={`text-taupe-600 no-underline hover:text-taupe-900 hover:bg-taupe-100 p-2 rounded-lg transition ${
                  active
                    ? "bg-taupe-100 text-taupe-900 font-medium"
                    : ""
                }`}
                aria-current={active ? "page" : undefined}
              >
                {label}
              </a>
            </li>
          );
        })
      }
      <li>
        <a
          href="/resume.pdf"
          download
          class="text-taupe-600 no-underline hover:text-taupe-900 hover:bg-taupe-100 p-3 rounded-lg font-medium shadow-woah hover:shadow-woah-more cursor-pointer"
        >
          Resume
        </a>
      </li>
    </ul>
  </nav>
</header>
