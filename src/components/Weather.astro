---
/**
 * Live temperature for Philadelphia via Open-Meteo (no API key).
 */
---

<p
  class="weather-philly flex items-center text-sm text-neutral-600 tabular-nums shrink-0 p-2"
  aria-label="Current temperature in Philadelphia"
>
  <span
    data-weather-temp
    class="flex items-center text-right"
    aria-live="polite">—</span
  ><span class="">°F</span>
</p>

<script is:inline>
  (function () {
    var root = document.querySelector(".weather-philly");
    var tempEl = root && root.querySelector("[data-weather-temp]");
    if (!tempEl) return;
    fetch(
      "https://api.open-meteo.com/v1/forecast?latitude=39.9526&longitude=-75.1652&current=temperature_2m&temperature_unit=fahrenheit",
    )
      .then(function (r) {
        return r.json();
      })
      .then(function (data) {
        var t = data && data.current && data.current.temperature_2m;
        if (typeof t === "number") tempEl.textContent = String(Math.round(t));
      })
      .catch(function () {
        tempEl.textContent = "—";
      });
  })();
</script>
