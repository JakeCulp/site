---
import CaseStudyImage from "./CaseStudyImage.astro";

interface Props {
  title: string;
  role: string;
  projectSummary: string;
  team: string[];
  heroImage: string;
}

const { title, role, team, projectSummary, heroImage } = Astro.props;
---

<header class="flex flex-col gap-8">
  <CaseStudyImage src={heroImage} alt="" />
  <h1
  >
    {title}
  </h1>
  <div class="flex gap-x-12 gap-y-4 leading-relaxed justify-between">
    <div class="flex flex-col">
      <h4 class="">Role</h4>
      <p class="">{role}</p>
    </div>
    <div class="flex flex-col">
      <h4 class="">Team</h4>
      <ul class="m-0 flex list-none flex-col p-0 ">
        {team.map((member) => <li>{member}</li>)}
      </ul>
    </div>
    <div class="flex flex-col md:w-1/2">
      <h4 class="">Project Summary</h4>
      <p class="">{projectSummary}</p>
    </div>
  </div>
</header>
