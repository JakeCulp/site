---
interface Competitor {
  name: string;
  image: string;
}

interface Props {
  competitors: Competitor[];
}

const { competitors } = Astro.props;
---

<div
  class="grid grid-cols-1 gap-5 bg-mist-100 p-4 rounded-[10px] sm:grid-cols-3"
>
  {
    competitors.map((competitor) => (
      <figure class="m-0 flex flex-col gap-3.5">
        <figcaption class="text-sm leading-snug text-mist-950">
          {competitor.name}
        </figcaption>
        <div class="overflow-hidden rounded-sm border-[5px] border-white bg-white shadow-woah">
          <img
            class="block h-auto w-full object-cover"
            src={competitor.image}
            alt={`${competitor.name} loan offer interface`}
            loading="lazy"
          />
        </div>
      </figure>
    ))
  }
</div>
