---
import Question from "phosphor-astro/QuestionDuotone.astro";

interface Props {
  text: string;
}

const { text } = Astro.props;
---

<div
  class="flex items-center gap-2.5 rounded-[10px] bg-blue-100 p-4 w-fit border-blue-200 border"
>
  <Question class="h-6 w-6 shrink-0 fill-[#2F609F]" />
  <span class="m-0 flex-1 text-base leading-normal text-neutral-950">{text}</span>
</div>
