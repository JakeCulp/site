---
interface Props {
  src: string;
  alt?: string;
}

const { src, alt = "" } = Astro.props;
---

<div
  class="w-full sm:aspect-5/3 aspect-square overflow-hidden rounded-[20px] outline-1 -outline-offset-1 outline-black/5"
>
  <img
    class="block h-auto w-full object-cover"
    src={src}
    alt={alt}
    loading="lazy"
  />
</div>
