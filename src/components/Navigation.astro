---
/**
 * Site navigation: logo + links.
 * Define links in one place; add/remove items in the `links` array.
 */
const links = [
  { href: "/", label: "Work" },
  { href: "/about", label: "About" },
  { href: "/links", label: "Links" },
];

import Logo from "../images/logo.svg";
import ArrowBendUpLeft from "phosphor-astro/ArrowBendUpLeft.astro";

interface Props {
  variant?: "default" | "back";
}

const { variant = "default" } = Astro.props;
---

<header class="pt-12 max-w-4xl m-auto flex justify-center">
  <nav
    class="mx-auto flex items-center justify-between gap-4"
    aria-label="Main navigation"
  >
    {
      variant === "default" ? (
        <a
          href="/"
          class="p-1 rounded-full hover:rotate-35 transition-transform ease-out"
        >
          <Logo class="" />
        </a>
      ) : (
        <div class="p-3 bg-mist-100 rounded-full transition hover:bg-mist-200 ">
          <a href="/">
            <ArrowBendUpLeft class="overflow-hidden w-5 h-5 fill-mist-600 hover:fill-mist-900" />
          </a>
        </div>
      )
    }
  </nav>
</header>
