---
/**
 * Site navigation: logo + links.
 * Define links in one place; add/remove items in the `links` array.
 */
const links = [
  { href: "/", label: "Work" },
  { href: "/about", label: "About" },
  { href: "/links", label: "Links" },
];

import Logo from "../images/logo.svg";
import ArrowBendUpLeft from "phosphor-astro/ArrowBendUpLeft.astro";
import Weather from "./Weather.astro";

interface Props {
  variant?: "default" | "back";
}

const { variant = "default" } = Astro.props;
---

<header
  class="pt-12 max-w-4xl m-auto px-6 xl:px-0 will-change-contents transition"
>
  <nav
    class="mx-auto flex items-center justify-between gap-4"
    aria-label="Main navigation"
  >
    {
      variant === "default" ? (
        <a href="/" class="">
          <Logo />
        </a>
      ) : (
        <div class="p-3 bg-taupe-100 rounded-full transition hover:bg-taupe-200 ">
          <a href="/">
            <ArrowBendUpLeft class="overflow-hidden w-5 h-5 fill-taupe-600 hover:fill-taupe-900" />
          </a>
        </div>
      )
    }
    {variant === "default" ? <Weather /> : null}
  </nav>
</header>
