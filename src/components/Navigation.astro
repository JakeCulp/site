---
/**
 * Site navigation: logo + links.
 * Define links in one place; add/remove items in the `links` array.
 */

import Logo from "../images/logo.svg";
import ArrowBendUpLeft from "phosphor-astro/ArrowBendUpLeft.astro";

interface Props {
  variant?: "default" | "back";
}

const { variant = "default" } = Astro.props;

const { url } = Astro;
const currentPath =
  url.pathname.endsWith("/") && url.pathname.length > 1
    ? url.pathname.slice(0, -1)
    : url.pathname;

// Utility function to check if link is active
function isActive(href: string) {
  // Always normalize: treat "/about" and "/about/" as the same
  const normalizedHref =
    href.endsWith("/") && href.length > 1 ? href.slice(0, -1) : href;
  return normalizedHref === currentPath;
}

const links = [
  { href: "/", label: "Work" },
  { href: "/now", label: "Now" },
  { href: "/photos", label: "Photos" },
  { href: "/reading", label: "Reading" },
];
---

<header class="pt-12 flex justify-center m-auto px-4 2xl:px-0">
  <nav
    class="mx-auto w-full flex items-center justify-between gap-4"
    aria-label="Main navigation"
  >
    {
      variant === "default" ? (
        <a
          href="/"
          class="p-1 rounded-full hover:rotate-35 transition-transform ease-out"
        >
          <Logo class="" />
        </a>
      ) : (
        <a href="/">
          <div class="p-3 bg-neutral-100 rounded-full transition hover:bg-neutral-200 ">
            <ArrowBendUpLeft class="overflow-hidden w-5 h-5 fill-neutral-600 hover:fill-neutral-900" />
          </div>
        </a>
      )
    }
    <ul class="flex flex-row gap-0 sm:gap-4">
      {
        links.map(({ href, label }) => {
          const active = isActive(href);
          return (
            <li class="transition ease-out duration-200 hover:translate-y-0.25">
              <a
                href={href}
                class={`text-neutral-600 hover:text-neutral-900 hover:bg-neutral-100 hover:no-underline p-2 rounded-lg transition ease-out duration-200 ${
                  active
                    ? "bg-neutral-100 text-neutral-900 font-medium no-underline"
                    : "underline decoration-neutral-700/20 hover:decoration-neutral-700 underline-offset-4"
                }`}
                aria-current={active ? "page" : undefined}
              >
                {label}
              </a>
            </li>
          );
        })
      }
      <li>
        <a
          href="/resume.pdf"
          download
          class="text-neutral-600 no-underline hover:text-neutral-900 hover:bg-neutral-100 p-2 rounded-lg font-medium shadow-woah hover:shadow-woah-more cursor-pointer"
        >
          Resume
        </a>
      </li>
    </ul>
  </nav>
</header>
