---
/**
 * Site navigation: logo + links.
 * Define links in one place; add/remove items in the `links` array.
 */
const links = [
  { href: '/', label: 'Work' },
  { href: '/about/', label: 'About' },
  { href: '/links', label: 'Links'}
];

import Logo from '../images/logo.svg';
---

<header class="pt-12 max-w-4xl m-auto">
  <nav class="mx-auto flex items-center justify-between gap-6 p-0" aria-label="Main navigation">
    <a href="/">
      <Logo />
    </a>
    <ul class="flex list-none gap-2 p-0 m-0 text-xl">
      {
        links.map(({ href, label }) => (
          <li>
            <a
              href={href}
              class="text-taupe-600 no-underline hover:text-taupe-900 hover:bg-taupe-100 p-3 rounded-md"
            >
              {label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
