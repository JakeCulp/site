---
/**
 * Hero section: large headline + subheadline.
 */

// Determine current path
const { url } = Astro;
const currentPath =
  url.pathname.endsWith("/") && url.pathname.length > 1
    ? url.pathname.slice(0, -1)
    : url.pathname;

// Utility function to check if link is active
function isActive(href: string) {
  // Always normalize: treat "/about" and "/about/" as the same
  const normalizedHref =
    href.endsWith("/") && href.length > 1 ? href.slice(0, -1) : href;
  return normalizedHref === currentPath;
}

const links = [
  { href: "/", label: "Work" },
  { href: "/now", label: "Now" },
  { href: "/photos", label: "Photos" },
  { href: "/reading", label: "Reading" },
];
---

<section class="hero max-w-4xl m-auto animate-enter">
  <h1 class="hero__headline text-mist-950 text-balance transition">
    Hi, I'm Jake. <br />
    <span class="text-mist-500">I'm a </span>product designer <span
      class="text-mist-500">based in</span
    >
    <span id="philly-team">Philadelphia</span>, Pennsylvania.
  </h1>
  <p
    class="hero__subheadline md:text-xl text-mist-500 pt-8 leading-relaxed py-12 max-w-prose"
  >
    I design digital products with a focus on clarity, systems, and making
    complex experiences feel intuitive. I approach design as both craft and
    infrastructure—shaping individual experiences while building systems that
    help products scale.
  </p>
</section>
<script is:inline>
  (function () {
    var el = document.getElementById("philly-team");
    if (!el) return;
    var colors = [
      "text-orange-600",
      "text-red-600",
      "text-green-600",
      "text-blue-600",
    ];
    var randomColor = colors[Math.floor(Math.random() * colors.length)];
    el.classList.add(randomColor);
  })();
</script>
<section class="flex max-w-4xl mx-auto gap-4 pb-8">
  <ul class="flex flex-row gap-4">
    {
      links.map(({ href, label }) => {
        const active = isActive(href);
        return (
          <li class="transition ease-out duration-200 hover:translate-y-0.25">
            <a
              href={href}
              class={`text-mist-600 hover:text-mist-900 hover:bg-mist-100 hover:no-underline p-2 rounded-lg transition ease-out duration-200 ${
                active
                  ? "bg-mist-100 text-mist-900 font-medium no-underline"
                  : "underline decoration-mist-700/20 hover:decoration-mist-700 underline-offset-4"
              }`}
              aria-current={active ? "page" : undefined}
            >
              {label}
            </a>
          </li>
        );
      })
    }
    <li>
      <a
        href="/resume.pdf"
        download
        class="text-mist-600 no-underline hover:text-mist-900 hover:bg-mist-100 p-2 rounded-lg font-medium shadow-woah hover:shadow-woah-more cursor-pointer"
      >
        Resume
      </a>
    </li>
  </ul>
</section>

<style>
  .hero {
    padding-block: clamp(2rem, 5vw, 4rem) 0;
  }

  .hero__headline {
    font-family: "Fraunces Variable", sans-serif;
    font-weight: 300;
    font-variation-settings:
      "WONK" 0,
      "SOFT" 100;
    font-optical-sizing: auto;
    font-size: clamp(2rem, calc(1.091rem + 4.545dvw), 4.5rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .hero__subheadline a {
    color: var(--color-green-700);
    text-decoration-thickness: 0.2ex;
    text-underline-offset: 0.15ex;
  }
</style>
