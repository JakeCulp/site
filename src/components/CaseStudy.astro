---
/**
 * Case Study Section
 * Top: company block (logo, title, description, years).
 * Below: cascading list of project case studies.
 */
export interface Company {
  logo: string;
  title: string;
  description: string;
  years: string;
}

export interface CaseStudyProject {
  image: string;
  title: string;
  description: string;
}

interface Props {
  company: Company;
  projects: CaseStudyProject[];
}

const { company, projects } = Astro.props;
---

<section class="max-w-3xl mx-auto flex flex-col items-stretch gap-5" aria-labelledby="case-study-company">
  <!-- Company header: logo + title, job description, years -->
  <div class="flex items-center gap-5" id="case-study-company">
    <div class="shrink-0 overflow-hidden h-[80px] w-[80px] rounded-xl outline-2 -outline-offset-2 outline-black/10">
      <img
        class="h-full w-full aspect-square"
        src={company.logo}
        alt=""
        loading="lazy"
      />
    </div>
    <div class="">
      <h2 class="font-semibold text-taupe-950 text-2xl/8 pb-1">
        {company.title}
      </h2>
      <p class="font-normal text-taupe-500 text-base/5 pb-1">
        {company.description}
      </p>
      <p class="font-normal text-taupe-500 text-base/5 pb-1">{company.years}</p>
    </div>
  </div>
  <!-- Cascading list of case study projects -->
  <div class="flex gap-5 w-full">
    <ul class="flex-1 list-none m-0 p-0 flex flex-col gap-12">
      {
        projects.map((project, i) => (
          <li class="m-auto">
            <div class="flex flex-col gap-5 bg-white p-4 rounded-[26px] shadow-woah hover:shadow-woah-more hover:scale-101 duration-200 ease-out transition-[scale,shadow] cursor-pointer">
              <div class="w-full overflow-hidden outline-2 -outline-offset-2 outline-black/10 rounded-[10px]">
                <img
                  class="w-full h-full object-cover aspect-3/2"
                  src={project.image}
                  alt=""
                  loading="lazy"
                />
              </div>
              <div class="flex flex-col">
                <h3 class="text-pretty text-2xl text-taupe-950 leading-relaxed">
                  {project.title}
                </h3>
                <p class="text-pretty text-base text-taupe-600 leading-relaxed">
                  {project.description}
                </p>
                {/* create cool tags for case studies here */}
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
