---
/**
 * Case Study Section
 * Top: company block (logo, title, description, years).
 * Below: cascading list of project case studies.
 */
export interface Company {
  logo: string;
  title: string;
  description: string;
  years: string;
}

export interface CaseStudyProject {
  image: string;
  title: string;
  categories?: string[];
}

interface Props {
  company: Company;
  projects: CaseStudyProject[];
}

const { company, projects } = Astro.props;
---

<section class="max-w-3xl mx-auto flex flex-col items-stretch gap-5" aria-labelledby="case-study-company">
  <!-- Company header: logo + title, job description, years -->
  <div class="flex items-center gap-5" id="case-study-company">
    <div class="shrink-0 overflow-hidden h-[80px] w-[80px] rounded-xl outline-2 -outline-offset-2 outline-black/10">
      <img
        class="h-full w-full aspect-square"
        src={company.logo}
        alt=""
        loading="lazy"
      />
    </div>
    <div class="">
      <h2 class="font-semibold text-taupe-950 text-2xl">
        {company.title}
      </h2>
      <p class="font-normal text-taupe-500 text-base">
        {company.description}
      </p>
      <p class="font-normal text-taupe-500 text-base">{company.years}</p>
    </div>
  </div>
  <!-- Cascading list of case study projects -->
  <div class="flex gap-5 w-full">
    <ul class="flex-1 list-none m-0 p-0 flex flex-col gap-12">
      {
        projects.map((project, i) => (
          <li class="m-auto">
            <div class="outline-taupe-200 hover:outline-8 flex flex-col gap-0 overflow-hidden bg-white rounded-xl shadow-woah transition-all duration-200 ease-out cursor-pointer will-change-transform">
              <div class="w-full">
                <img
                  class="w-full h-full object-cover aspect-video"
                  src={project.image}
                  alt=""
                  loading="lazy"
                />
              </div>
              <div class="flex flex-col p-4">
                <h3 class="text-balance text-2xl text-taupe-950 leading-relaxed font-semibold" >
                  {project.title}
                </h3>
                {project.categories?.length ? (
                  (() => {
                    // Use a deterministic approach to assign a unique color to each category per project.
                    const tagColors = [
                      'bg-sky-100 text-sky-900',
                      'bg-amber-100 text-amber-900',
                      'bg-emerald-100 text-emerald-900',
                      'bg-purple-100 text-purple-900',
                      'bg-pink-100 text-pink-900',
                      'bg-orange-100 text-orange-900',
                      'bg-teal-100 text-teal-900',
                      'bg-indigo-100 text-indigo-900',
                      'bg-lime-100 text-lime-900',
                      'bg-cyan-100 text-cyan-900',
                      'bg-fuchsia-100 text-fuchsia-900',
                    ];
                    // Shuffle colors so each project gets a random palette, but colors remain unique per project
                    function shuffle(array: string[]) {
                      let arr = array.slice();
                      for (let i = arr.length - 1; i > 0; i--) {
                        const j = Math.floor(Math.random() * (i + 1));
                        [arr[i], arr[j]] = [arr[j], arr[i]];
                      }
                      return arr;
                    }
                    const colorPalette = shuffle(tagColors);

                    return (
                      <ul class="flex flex-wrap gap-2 mt-2 list-none m-0 p-0" aria-label="Categories">
                        {project.categories.map((category, idx) => {
                          // Use index to ensure one color per category in this project
                          const colorClass = colorPalette[idx % colorPalette.length];
                          return (
                            <li>
                              <span
                                class={`inline-block px-2.5 py-1 rounded-lg font-normal ${colorClass}`}
                              >
                                {category}
                              </span>
                            </li>
                          );
                        })}
                      </ul>
                    );
                  })()
                ) : null}
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
