---
import SiteShell from "./SiteShell.astro";
import "@fontsource-variable/fraunces/full.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<SiteShell
  title={title}
  navigationVariant="back"
  mainClass="mx-auto flex flex-col gap-12 py-8 animate-enter"
>
  <slot />
</SiteShell>
