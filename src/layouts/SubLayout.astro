---
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import "@fontsource/fraunces";
import "@fontsource-variable/public-sans";
import "@fontsource/geist";
import "@fontsource-variable/fraunces/full.css";
import "@fontsource-variable/libre-franklin";
import HomeNavigation from "../components/Navigation.astro";
import Agentation from "../components/Agentation.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alt icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body
    class="font-sans antialiased bg-white text-neutral-950 max-w-4xl mx-auto cursor-[url('../images/cursor.svg'),pointer]"
  >
    <HomeNavigation variant="back" />
    <main class="flex mx-auto py-8 flex-col gap-4">
      <slot />
    </main>
    <Footer />
    <Agentation />
  </body>
</html>
<style>
  .hero__subheadline a {
    color: var(--color-green-700);
    text-decoration-thickness: 0.2ex;
    text-underline-offset: 0.15ex;
  }
</style>
