---
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '@fontsource/fraunces';
import '@fontsource-variable/public-sans';
import '@fontsource/geist';
import '@fontsource-variable/fraunces/full.css';
import HomeNavigation from '../components/Navigation.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alt icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="font-sans antialiased bg-taupe-50 text-taupe-950 max-w-4xl mx-auto cursor-[url('../images/cursor.svg'),pointer]">
    <HomeNavigation variant='back'/>
    <main class="mx-auto px-6 py-8">
      <slot />
    </main>
    <Footer />
  </body>
</html>
