---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Style Guide">
  <section class="py-16 sm:py-24">
    <div class="max-w-3xl space-y-4">
      <p class="text-xs font-medium uppercase tracking-wider text-neutral-500">
        Design system
      </p>
      <h1>Style guide</h1>
      <p class="text-lg text-neutral-700">
        A living reference for the typography, spacing, and UI patterns used
        across this site.
      </p>
    </div>

    <div class="mt-16 grid gap-6">
      <section class="rounded-[2rem] border border-neutral-200 bg-neutral-50 p-8 shadow-woah">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h2 class="m-0">Typography</h2>
          <p class="text-sm uppercase tracking-[0.25em] text-neutral-500">
            Headings & body
          </p>
        </div>

        <div class="mt-8 space-y-6">
          <div class="space-y-3">
            <h1>Heading 1</h1>
            <h2>Heading 2</h2>
            <h3>Heading 3</h3>
            <h4>Heading 4</h4>
            <h5>Heading 5</h5>
            <h6>Heading 6</h6>
          </div>

          <div class="grid gap-8 lg:grid-cols-[1.2fr_0.8fr]">
            <div class="space-y-4">
              <p class="text-lg text-neutral-700">
                Body copy uses a warm, readable sans serif for long-form writing
                and interface text.
              </p>
              <p>
                Small details matter. These are the everyday notes that make a
                design feel considered rather than generic.
              </p>
              <p class="text-sm leading-7 text-neutral-600">
                This smaller supporting text is useful for metadata, captions,
                and secondary notes.
              </p>
            </div>

            <div class="space-y-4">
              <ul class="list-disc space-y-2 pl-5 text-neutral-700">
                <li>Unordered list item</li>
                <li>Another list item</li>
                <li>And a third one</li>
              </ul>
              <ol class="list-decimal space-y-2 pl-5 text-neutral-700">
                <li>Ordered list item</li>
                <li>Another ordered item</li>
                <li>And a third one</li>
              </ol>
              <blockquote class="border-l-2 border-neutral-300 pl-4 text-neutral-700 italic">
                “A quote can be a useful anchor for highlighting a principle or
                perspective.”
              </blockquote>
            </div>
          </div>
        </div>
      </section>

      <section class="grid gap-6 lg:grid-cols-2">
        <div class="rounded-[2rem] border border-neutral-200 bg-white p-8 shadow-woah">
          <h2 class="m-0">Links & buttons</h2>
          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href="/"
              class="rounded-full bg-neutral-950 px-4 py-2 text-sm font-medium text-white transition hover:bg-neutral-800"
            >
              Primary action
            </a>
            <a
              href="/style-guide"
              class="rounded-full border border-neutral-300 bg-white px-4 py-2 text-sm font-medium text-neutral-800 transition hover:bg-neutral-100"
            >
              Secondary action
            </a>
          </div>
          <div class="mt-6 space-y-3">
            <a
              href="/"
              class="block text-neutral-700 underline decoration-neutral-400 underline-offset-4 transition hover:text-neutral-950 hover:decoration-neutral-700"
            >
              Default inline link
            </a>
            <a
              href="/style-guide"
              class="block text-neutral-600 transition hover:text-neutral-950"
            >
              Muted link with hover state
            </a>
          </div>
        </div>

        <div class="rounded-[2rem] border border-neutral-200 bg-white p-8 shadow-woah">
          <h2 class="m-0">Pills & surfaces</h2>
          <div class="mt-8 flex flex-wrap gap-3">
            <span class="rounded-full bg-neutral-100 px-3 py-1 text-sm text-neutral-700">
              Product design
            </span>
            <span class="rounded-full bg-neutral-900 px-3 py-1 text-sm text-white">
              Case study
            </span>
            <span class="rounded-full border border-neutral-300 px-3 py-1 text-sm text-neutral-700">
              Editorial
            </span>
          </div>
          <div class="mt-8 grid gap-4 sm:grid-cols-2">
            <article class="rounded-2xl border border-neutral-200 bg-neutral-50 p-5">
              <p class="text-sm uppercase tracking-[0.25em] text-neutral-500">
                Surface
              </p>
              <p class="mt-2 text-neutral-700">
                A simple card for supporting content and notes.
              </p>
            </article>
            <article class="rounded-2xl border border-neutral-200 bg-white p-5 shadow-woah">
              <p class="text-sm uppercase tracking-[0.25em] text-neutral-500">
                Elevated surface
              </p>
              <p class="mt-2 text-neutral-700">
                A slightly stronger card for featured content.
              </p>
            </article>
          </div>
        </div>
      </section>

      <section class="rounded-[2rem] border border-neutral-200 bg-white p-8 shadow-woah">
        <h2 class="m-0">Color & texture</h2>
        <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          <div class="rounded-2xl border border-neutral-200 bg-white p-4">
            <div class="h-16 rounded-xl border border-neutral-200 bg-white"></div>
            <p class="mt-3 text-sm font-medium">White</p>
            <p class="text-sm text-neutral-600">Neutral base</p>
          </div>
          <div class="rounded-2xl border border-neutral-200 bg-white p-4">
            <div class="h-16 rounded-xl border border-neutral-200 bg-neutral-50"></div>
            <p class="mt-3 text-sm font-medium">Neutral 50</p>
            <p class="text-sm text-neutral-600">Soft surfaces</p>
          </div>
          <div class="rounded-2xl border border-neutral-200 bg-white p-4">
            <div class="h-16 rounded-xl bg-neutral-100"></div>
            <p class="mt-3 text-sm font-medium">Neutral 100</p>
            <p class="text-sm text-neutral-600">Subtle emphasis</p>
          </div>
          <div class="rounded-2xl border border-neutral-200 bg-white p-4">
            <div class="h-16 rounded-xl bg-neutral-900"></div>
            <p class="mt-3 text-sm font-medium">Neutral 900</p>
            <p class="text-sm text-neutral-600">High contrast</p>
          </div>
        </div>
      </section>
    </div>
  </section>
</BaseLayout>
