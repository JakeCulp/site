---

<SubLayout title="Jake Culp, Senior Product Designer">
  <div class=""><h1>What I'm Reading</h1></div>
  <p>
    This list started in 2025, when I decided I needed to read more books, a
    decision I haven't regretted since.
  </p>
  <div class="flex flex-col">
    <p class="text-balance text-neutral-600 leading-relaxed">Currently:</p>
    {
      currentlyReading.map((book) => (
        <li class=" text-neutral-600 list-inside">
          <a
            href={book.url}
            target="_blank"
            class="underline text-neutral-950 decoration-neutral-700/40 hover:decoration-neutral-700 cursor-alias"
          >
            {book.title}
          </a>
          &nbsp;by {book.author}
        </li>
      ))
    }
  </div>
  <div class="flex md:flex-row gap-8 flex-col size-full">
    <div class="flex flex-col size-fit">
      <p class="text-balance text-neutral-600 leading-relaxed">Have read:</p>
      {
        haveRead.map((book) => (
          <li class="text-base text-neutral-600 py-1 list-inside">
            <a
              href={book.url}
              target="_blank"
              class="underline text-neutral-950 decoration-neutral-700/40 hover:decoration-neutral-700 cursor-alias"
            >
              {book.title}
            </a>{" "}
            by {book.author}
          </li>
        ))
      }
    </div>
  </div>
</SubLayout>

<style>
  .fraunces-italic {
    font-family: "Fraunces Variable", sans-serif;
    font-weight: 300;
    font-variation-settings:
      "WONK" 0,
      "SOFT" 100;
    font-optical-sizing: auto;
    text-decoration-thickness: 0.2ex;
    text-underline-offset: 0.15ex;
  }
</style>
