---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import CaseStudy, { type Company, type CaseStudyProject } from '../components/CaseStudy.astro';

import beLogo from '../images/be-logo.svg';
import lockheedLogo from '../images/lockheed.jpeg';

const bestEgg: Company = {
  logo: '{beLogo.src}',
  title: 'Best Egg',
  description: 'Senior Product Designer',
  years: '2021 - Present',
};

const bestEggProjects: CaseStudyProject[] = [
  {
    image: 'https://picsum.photos/1200/800',
    title: 'Designing a Clearer Loan Offer Experience',
    categories: ['Conversion', 'Responsive', 'UX Strategy'],
  },
  {
    image: 'https://picsum.photos/1000/800',
    title: 'Design System',
    categories: ['Design Systems', 'Components'],
  },
  {
    image: 'https://picsum.photos/1000/700',
    title: 'Case Study Title',
    categories: ['Research', 'Prototyping'],
  },
];

---

<BaseLayout title="Jake Culp - Senior Product Designer">
  <Hero />
  <CaseStudy company={bestEgg} projects={bestEggProjects}/>
  <section class="max-w-3xl mx-auto flex flex-col items-stretch gap-5 py-12" aria-labelledby="case-study-company">
    <!-- Company header: logo + title, job description, years -->
    <div class="flex items-center gap-5" id="case-study-company">
      <div class="shrink-0 overflow-hidden h-[80px] w-[80px] rounded-xl outline-2 -outline-offset-2 outline-black/10">
        <img
          class="h-full w-full aspect-square"
          src={lockheedLogo.src}
          alt=""
          loading="lazy"
        />
      </div>
      <div>
        <h2 class="font-semibold text-taupe-950 text-2xl">
          Lockheed Martin
        </h2>
        <p class="font-normal text-taupe-500 text-base">
          UX Designer
        </p>
        <p class="font-normal text-taupe-500 text-base">2019-2021</p>
      </div>
    </div>
    <p class="text-xl text-taupe-600">My time at lockhedd was</p>
    </section>
</BaseLayout>
