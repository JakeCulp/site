---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import CaseStudy, { type Company, type CaseStudyProject } from '../components/CaseStudy.astro';

const bestEgg: Company = {
  logo: 'src/images/be-logo.svg',
  title: 'Best Egg',
  description: 'Senior Product Designer',
  years: '2021 - Present',
};

const bestEggProjects: CaseStudyProject[] = [
  {
    image: 'https://picsum.photos/1200/800',
    title: 'Designing a Clearer Loan Offer Experience',
    categories: ['Conversion', 'Responsive', 'UX Strategy'],
  },
  {
    image: 'https://picsum.photos/1000/800',
    title: 'Design System',
    categories: ['Design Systems', 'Components'],
  },
  {
    image: 'https://picsum.photos/1000/700',
    title: 'Case Study Title',
    categories: ['Research', 'Prototyping'],
  },
];
---

<BaseLayout title="Jake Culp - Senior Product Designer">
  <Hero />
  <CaseStudy company={bestEgg} projects={bestEggProjects} />
</BaseLayout>
