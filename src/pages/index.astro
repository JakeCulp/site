---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import CaseStudy, {
  type Company,
  type CaseStudyProject,
} from "../components/CaseStudy.astro";

import beLogo from "../images/be-logo.svg";
import lockheedLogo from "../images/lockheed.jpeg";

const bestEgg: Company = {
  logo: beLogo.src,
  title: "Best Egg",
  description: "Senior Product Designer",
  years: "2021 - Present",
};

const bestEggProjects: CaseStudyProject[] = [
  {
    image: "https://picsum.photos/1200/800",
    title: "Designing a Clearer Loan Offer Experience",
    categories: ["Conversion", "Responsive", "UX Strategy"],
  },
  {
    image: "https://picsum.photos/1000/800",
    title: "Design System",
    categories: ["Design Systems", "Components"],
  },
  {
    image: "https://picsum.photos/1000/700",
    title: "Case Study Title",
    categories: ["Research", "Prototyping"],
  },
];
---

<BaseLayout title="Jake Culp, Senior Product Designer">
  <Hero />
  <CaseStudy company={bestEgg} projects={bestEggProjects} />
  <section
    class="max-w-3xl mx-auto flex-row items-stretch py-12 animate-enter"
    aria-labelledby="case-study-company"
  >
    <!-- Company header: logo + title, job description, years -->
    <div class="flex justify-between" id="case-study-company">
      <div class="flex align-middle gap-2">
        <div
          class="shrink-0 overflow-hidden h-8 w-8 rounded-md outline-2 -outline-offset-2 outline-black/10"
        >
          <img
            class="h-full w-full aspect-square"
            src={lockheedLogo.src}
            alt=""
            loading="lazy"
          />
        </div>
        <p class="font-semibold text-taupe-950 text-base self-center">
          Lockheed Martin
        </p>
      </div>
      <p class="font-normal text-taupe-500 text-sm self-center">UX Designer</p>
    </div>

    <!-- <p class="font-normal text-taupe-500 text-sm">{company.years}</p> -->
  </section>
</BaseLayout>
